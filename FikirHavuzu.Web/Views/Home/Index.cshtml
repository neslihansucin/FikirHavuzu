@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container-fluid px-0">
    <div class="mb-4">
        <h3 class="fw-bold mb-1" style="color: var(--text-primary); letter-spacing: -0.02em;">👋 Hoş Geldiniz, @User.Identity.Name!</h3>
        @if (ViewBag.IsPermissionManagement == true)
        {
            <p class="mb-0" style="color: var(--text-secondary); font-size: 0.95rem;">Fikir Havuzu sistem ayarlarını ve yetki tanımlamalarını buradan yönetebilirsiniz.</p>
        }
        else if (ViewBag.IsUserManagement == true && ViewBag.IsIdeaEvaluation == true)
        {
            <p class="mb-0" style="color: var(--text-secondary); font-size: 0.95rem;">Çalışan listesini, kullanıcı hesaplarını ve fikir değerlendirme süreçlerini buradan yönetebilirsiniz.</p>
        }
        else if (ViewBag.IsUserManagement == true)
        {
            <p class="mb-0" style="color: var(--text-secondary); font-size: 0.95rem;">Çalışan listesini ve kullanıcı hesaplarını buradan yönetebilirsiniz.</p>
        }
        else if (ViewBag.IsIdeaEvaluation == true)
        {
            <p class="mb-0" style="color: var(--text-secondary); font-size: 0.95rem;">Fikir ve önerileri inceleyebilir, puanlama ve değerlendirme süreçlerini buradan yönetebilirsiniz.</p>
        }
        else
        {
            <p class="mb-0" style="color: var(--text-secondary); font-size: 0.95rem;">Fikir Havuzu'nda sular şimdilik sakin. Yeni bir fikir atıp havuzu hareketlendirmeye ne dersin?</p>
        }
    </div>

    @if (ViewBag.IsManagementUser == true)
    {
        <div class="row g-3 mb-4">
            @if (ViewBag.IsUserManagement == true)
            {
                <div class="col-md-4">
                    <div class="flat-card h-100 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-uppercase fw-semibold" style="color: var(--text-muted); font-size: 0.75rem; letter-spacing: 0.04em;">Toplam Çalışan</span>
                                <h2 class="fw-bold my-2" style="color: var(--text-primary); letter-spacing: -0.03em;">@ViewBag.TotalUsers</h2>
                            </div>
                            <div class="p-2 rounded-3" style="background-color: var(--bg-canvas); color: var(--brand-primary);">
                                <i class="bi bi-people fs-4"></i>
                            </div>
                        </div>
                        <div class="pt-3" style="border-top: 1px solid var(--border-subtle);">
                            <a href="/User/List" class="btn btn-sm btn-secondary-custom w-100">Yönet</a>
                        </div>
                    </div>
                </div>
            }

            @if (ViewBag.IsIdeaEvaluation == true)
            {
                <div class="col-md-4">
                    <div class="flat-card h-100 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-uppercase fw-semibold" style="color: var(--text-muted); font-size: 0.75rem; letter-spacing: 0.04em;">Toplam Fikir</span>
                                <h2 class="fw-bold my-2" style="color: var(--text-primary); letter-spacing: -0.03em;">@ViewBag.TotalIdeas</h2>
                            </div>
                            <div class="p-2 rounded-3" style="background-color: var(--brand-primary-light); color: var(--brand-primary);">
                                <i class="bi bi-stars fs-4"></i>
                            </div>
                        </div>
                        <div class="pt-3" style="border-top: 1px solid var(--border-subtle);">
                            <a href="/Idea/List" class="btn btn-sm btn-secondary-custom w-100">İncele</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="flat-card h-100 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="text-uppercase fw-semibold" style="color: var(--text-muted); font-size: 0.75rem; letter-spacing: 0.04em;">Bekleyen Fikirler</span>
                                <h2 class="fw-bold my-2" style="color: var(--text-primary); letter-spacing: -0.03em;">@ViewBag.PendingIdeasCount</h2>
                            </div>
                            <div class="p-2 rounded-3" style="background-color: var(--badge-amber-bg); color: var(--badge-amber-text);">
                                <i class="bi bi-hourglass-split fs-4"></i>
                            </div>
                        </div>
                        <div class="pt-3" style="border-top: 1px solid var(--border-subtle);">
                            <a href="/Idea/List?filter=pending" class="btn btn-sm btn-brand w-100">Değerlendir</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="flat-card">
                    <h5 class="fw-bold mb-2" style="color: var(--text-primary);"><i class="bi bi-grid me-2 text-muted"></i> Hızlı Yönetim Paneli</h5>
                    <p style="color: var(--text-secondary); font-size: 0.9rem;">Sistem yetkileriniz kapsamında aşağıdaki yönetimsel araçlara erişebilirsiniz:</p>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        @if (ViewBag.IsUserManagement == true)
                        {
                            <a href="/User/Create" class="btn btn-brand"><i class="bi bi-person-plus me-1"></i> Çalışan Tanımla</a>
                        }
                        @if (ViewBag.IsIdeaEvaluation == true)
                        {
                            <a href="/Idea/List?filter=pending" class="btn btn-secondary-custom"><i class="bi bi-check2-all me-1"></i> Bekleyen Fikirleri Puanla</a>
                        }
                        @if (ViewBag.IsPermissionManagement == true)
                        {
                            <a href="/Permission/Manage" class="btn btn-secondary-custom"><i class="bi bi-shield-lock me-1"></i> Yetki Ata</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="flat-card h-100 d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-uppercase fw-semibold" style="color: var(--text-muted); font-size: 0.75rem; letter-spacing: 0.04em;">Fikir Önerilerim</span>
                            <h2 class="fw-bold my-2" style="color: var(--text-primary); letter-spacing: -0.03em;">@ViewBag.MyTotalIdeas</h2>
                        </div>
                        <div class="p-2 rounded-3" style="background-color: var(--bg-canvas); color: var(--brand-primary);">
                            <i class="bi bi-journal-text fs-4"></i>
                        </div>
                    </div>
                    <div class="pt-3" style="border-top: 1px solid var(--border-subtle);">
                        <a href="/Idea/MyIdeas" class="btn btn-sm btn-secondary-custom w-100">Görüntüle</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="flat-card h-100 d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-uppercase fw-semibold" style="color: var(--text-muted); font-size: 0.75rem; letter-spacing: 0.04em;">Onaylanan Fikirlerim</span>
                            <h2 class="fw-bold my-2" style="color: var(--badge-green-text); letter-spacing: -0.03em;">@ViewBag.MyApprovedIdeas</h2>
                        </div>
                        <div class="p-2 rounded-3" style="background-color: var(--badge-green-bg); color: var(--badge-green-text);">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>
                    </div>
                    <div class="pt-3" style="border-top: 1px solid var(--border-subtle);">
                        <a href="/Idea/MyIdeas" class="btn btn-sm btn-secondary-custom w-100">Takip Et</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="flat-card h-100 d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="text-uppercase fw-semibold" style="color: var(--text-muted); font-size: 0.75rem; letter-spacing: 0.04em;">Değerlendirme Aşamasında</span>
                            <h2 class="fw-bold my-2" style="color: var(--badge-amber-text); letter-spacing: -0.03em;">@ViewBag.MyPendingIdeas</h2>
                        </div>
                        <div class="p-2 rounded-3" style="background-color: var(--badge-amber-bg); color: var(--badge-amber-text);">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>
                    </div>
                    <div class="pt-3" style="border-top: 1px solid var(--border-subtle);">
                        <a href="/Idea/MyIdeas" class="btn btn-sm btn-secondary-custom w-100">Süreci İzle</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="flat-card">
                    <h5 class="fw-bold mb-2" style="color: var(--text-primary);"><i class="bi bi-stars me-2 text-warning"></i> Yeni Bir Proje / İnovasyon Fikriniz mi Var?</h5>
                    <p style="color: var(--text-secondary); font-size: 0.9rem;">Kurumumuzun operasyonel verimliliğini, ürün kalitesini veya hizmet standartlarını yükselteceğini düşündüğünüz fikirlerinizi hemen paylaşın, kurum içi inovasyonu birlikte büyütelim.</p>
                    <div class="mt-3">
                        <a href="/Idea/Create" class="btn btn-brand"><i class="bi bi-plus-circle me-2"></i> Yeni Fikir Önerisi Gönder</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
