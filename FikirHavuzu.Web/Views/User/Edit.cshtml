@model FikirHavuzu.Entity.Entities.User
@{
    ViewData["Title"] = "Çalışanı Düzenle";
    var userPermissionIds = ViewBag.UserPermissionIds as List<int> ?? new List<int>();
    var allPermissions = ViewBag.AllPermissions as IEnumerable<FikirHavuzu.Entity.Entities.Permission> ?? new List<FikirHavuzu.Entity.Entities.Permission>();
    bool isSuperAdmin = ViewBag.IsSuperAdmin == true;
    int currentUserId = ViewBag.CurrentUserId != null ? (int)ViewBag.CurrentUserId : 0;
    int totalIdeas = ViewBag.TotalIdeas != null ? (int)ViewBag.TotalIdeas : 0;
    int approvedIdeas = ViewBag.ApprovedIdeas != null ? (int)ViewBag.ApprovedIdeas : 0;
    int implementedIdeas = ViewBag.ImplementedIdeas != null ? (int)ViewBag.ImplementedIdeas : 0;
    int userPoints = ViewBag.UserPoints != null ? (int)ViewBag.UserPoints : 0;
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="flat-card p-4">
                <div class="mb-4">
                    <h4 class="fw-bold mb-1" style="color: var(--text-primary); letter-spacing: -0.01em;">✏️ Çalışan Bilgilerini Düzenle</h4>
                    <p class="mb-0" style="color: var(--text-secondary); font-size: 0.9rem;">
                        <strong>@Model.FirstName @Model.LastName</strong>
                        @if (Model.Id == currentUserId)
                        {
                            <span class="badge-soft-neutral text-muted fw-semibold me-1" style="font-size: 0.75rem; padding: 2px 6px;">(Siz)</span>
                        }
                        (@Model.RegistrationNumber) kullanıcısının hesap detayları.
                    </p>
                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 py-2 px-3 mb-4" style="font-size: 0.9rem;" role="alert">
                        <strong>Hata!</strong> @ViewBag.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Employee Innovation & Productivity Widget -->
                <div class="p-3 rounded-3 mb-4" style="background-color: var(--bg-canvas); border: 1px solid var(--border-subtle);">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-uppercase fw-semibold" style="color: var(--text-muted); font-size: 0.72rem; letter-spacing: 0.04em;">✨ İnovasyon & Katılım Özeti</span>
                        @if (userPoints > 0)
                        {
                            <span class="badge" style="background-color: #FEF3C7; color: #92400E; border: 1px solid #F59E0B; font-size: 0.75rem;">@userPoints İnovasyon Puanı</span>
                        }
                        else
                        {
                            <span class="badge-soft-neutral" style="font-size: 0.72rem;">0 Puan</span>
                        }
                    </div>
                    <div class="row g-2 text-center">
                        <div class="col-4">
                            <div class="p-2 bg-white rounded-2 border">
                                <span class="text-muted d-block small" style="font-size: 0.75rem;">Toplam Fikir</span>
                                <span class="fw-bold fs-5" style="color: var(--text-primary);">@totalIdeas</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-white rounded-2 border">
                                <span class="text-muted d-block small" style="font-size: 0.75rem;">Olumlu Fikir</span>
                                <span class="fw-bold fs-5 text-success">@approvedIdeas</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-white rounded-2 border">
                                <span class="text-muted d-block small" style="font-size: 0.75rem;">Pırıltılı Fikir</span>
                                <span class="fw-bold fs-5 text-warning">@implementedIdeas</span>
                            </div>
                        </div>
                    </div>
                </div>

                <form action="/User/Edit/@Model.Id" method="post">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Ad *</label>
                            <input type="text" name="firstName" class="form-control form-control-sm" value="@Model.FirstName" pattern="[a-zA-ZğüşıöçĞÜŞİÖÇ\s]+" oninput="this.value = this.value.replace(/[^a-zA-ZğüşıöçĞÜŞİÖÇ\s]/g, '')" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Soyad *</label>
                            <input type="text" name="lastName" class="form-control form-control-sm" value="@Model.LastName" pattern="[a-zA-ZğüşıöçĞÜŞİÖÇ\s]+" oninput="this.value = this.value.replace(/[^a-zA-ZğüşıöçĞÜŞİÖÇ\s]/g, '')" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Sicil Numarası *</label>
                            <input type="text" name="registrationNumber" class="form-control form-control-sm font-monospace" value="@Model.RegistrationNumber" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">TC Kimlik No (11 Haneli Rakam) *</label>
                            <input type="text" name="tcKimlikNo" class="form-control form-control-sm font-monospace" value="@Model.TCNo" minlength="11" maxlength="11" pattern="[0-9]{11}" placeholder="11 haneli rakam" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">E-posta *</label>
                            <input type="email" name="email" class="form-control form-control-sm" value="@Model.Email" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Telefon Numarası</label>
                            <input type="tel" name="phoneNumber" class="form-control form-control-sm" value="@Model.PhoneNumber" maxlength="11" placeholder="05XXXXXXXXX" pattern="[0-9]{10,11}" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Hesap Durumu</label>
                        <div class="form-check form-switch mt-1">
                            <input class="form-check-input" type="checkbox" name="isActive" value="true" id="isActiveSwitch" @(Model.IsActive ? "checked" : "") />
                            <label class="form-check-label small" for="isActiveSwitch">Çalışan Hesabı Aktif</label>
                        </div>
                    </div>

                    @if (isSuperAdmin)
                    {
                        <div class="mb-4 pt-3" style="border-top: 1px solid var(--border-subtle);">
                            <label class="form-label small fw-semibold d-block mb-2" style="color: var(--text-primary);"><i class="bi bi-shield-lock me-1"></i> Rol & Yetki Tanımlaması</label>
                            <div class="d-flex flex-column gap-2">
                                @foreach (var perm in allPermissions)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="permissionIds" value="@perm.Id" id="perm_@perm.Id" @(userPermissionIds.Contains(perm.Id) ? "checked" : "")>
                                        <label class="form-check-label small" for="perm_@perm.Id">
                                            <strong>@perm.Name</strong> - <span class="text-muted">@perm.Description</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2 pt-3" style="border-top: 1px solid var(--border-subtle);">
                        <a href="/User/List" class="btn btn-sm btn-secondary-custom px-3">İptal</a>
                        <button type="submit" class="btn btn-sm btn-brand px-3">Değişiklikleri Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
