@model FikirHavuzu.Entity.Entities.User
@{
    ViewData["Title"] = "Yeni Çalışan Ekle";
    var allPermissions = ViewBag.AllPermissions as IEnumerable<FikirHavuzu.Entity.Entities.Permission> ?? new List<FikirHavuzu.Entity.Entities.Permission>();
    bool isSuperAdmin = ViewBag.IsSuperAdmin == true;
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="flat-card p-4">
                <div class="mb-4">
                    <h4 class="fw-bold mb-1" style="color: var(--text-primary); letter-spacing: -0.01em;">👤 Yeni Çalışan Tanımla</h4>
                    <p class="mb-0" style="color: var(--text-secondary); font-size: 0.9rem;">Sisteme yeni bir çalışan ekleyin ve yetki rolünü belirleyin.</p>
                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 py-2 px-3 mb-4" style="font-size: 0.9rem;" role="alert">
                        <strong>Hata!</strong> @ViewBag.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form action="/User/Create" method="post">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Ad *</label>
                            <input type="text" name="FirstName" class="form-control form-control-sm" pattern="[a-zA-ZğüşıöçĞÜŞİÖÇ\s]+" oninput="this.value = this.value.replace(/[^a-zA-ZğüşıöçĞÜŞİÖÇ\s]/g, '')" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Soyad *</label>
                            <input type="text" name="LastName" class="form-control form-control-sm" pattern="[a-zA-ZğüşıöçĞÜŞİÖÇ\s]+" oninput="this.value = this.value.replace(/[^a-zA-ZğüşıöçĞÜŞİÖÇ\s]/g, '')" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Sicil Numarası</label>
                            <input type="text" name="RegistrationNumber" class="form-control form-control-sm font-monospace bg-light" value="@ViewBag.NextRegistrationNumber" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">TC Kimlik No (11 Haneli Rakam) *</label>
                            <input type="text" name="TCNo" class="form-control form-control-sm font-monospace" minlength="11" maxlength="11" pattern="[0-9]{11}" placeholder="Örn: 12345678901" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">E-posta *</label>
                            <input type="email" name="Email" class="form-control form-control-sm" placeholder="ad.soyad@kurum.com" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Telefon Numarası *</label>
                            <input type="tel" name="PhoneNumber" class="form-control form-control-sm" maxlength="11" placeholder="05XXXXXXXXX" pattern="[0-9]{10,11}" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required />
                        </div>
                    </div>

                    @if (isSuperAdmin)
                    {
                        <div class="mb-4 pt-3" style="border-top: 1px solid var(--border-subtle);">
                            <label class="form-label small fw-semibold d-block mb-2" style="color: var(--text-primary);"><i class="bi bi-shield-lock me-1"></i> Rol & Yetki Tanımlaması</label>
                            <div class="d-flex flex-column gap-2">
                                @foreach (var perm in allPermissions)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="permissionIds" value="@perm.Id" id="perm_@perm.Id">
                                        <label class="form-check-label small" for="perm_@perm.Id">
                                            <strong>@perm.Name</strong> - <span class="text-muted">@perm.Description</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2 pt-3" style="border-top: 1px solid var(--border-subtle);">
                        <a href="/User/List" class="btn btn-sm btn-secondary-custom px-3">İptal</a>
                        <button type="submit" class="btn btn-sm btn-brand px-3">Çalışanı Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
