@model IEnumerable<FikirHavuzu.Entity.Entities.Idea>
@{
    ViewData["Title"] = "Pırıltılı Fikir Tanımla";
}

<div class="container-fluid px-0">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="flat-card p-4">
                <div class="mb-4">
                    <h4 class="fw-bold mb-1" style="color: var(--text-primary); letter-spacing: -0.01em;">🌟 Pırıltılı Fikir Tanımla</h4>
                    <p class="mb-0" style="color: var(--text-secondary); font-size: 0.9rem;">Olumlu değerlendirilmiş bir fikri kurum süreçlerine/ürünlerine entegre edin ve Pırıltılı Fikirler vitrininde yayınlayın.</p>
                </div>
                
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show rounded-3 py-2 px-3 mb-4" style="font-size: 0.9rem;" role="alert">
                        <strong>Hata!</strong> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (!Model.Any())
                {
                    <div class="p-4 rounded-2 text-center my-3" style="background-color: var(--badge-amber-bg); color: var(--badge-amber-text); border: 1px solid rgba(146,64,14,0.15);">
                        <span class="fs-4 d-block mb-1">⚠️</span>
                        <strong>Vitrinin ışıkları kapalı çünkü henüz onaylanmış bir 'Pırıltılı Fikir' yok.</strong>
                        <p class="mb-0 mt-1 small">İlk ışığı yakmak için bekleyen önerileri değerlendirmeye başlayabilirsiniz.</p>
                        <a href="/Idea/List" class="btn btn-sm btn-brand px-3 mt-3">Fikir Listesine Git</a>
                    </div>
                }
                else
                {
                    <form action="/Idea/CreateShowcase" method="post">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Referans Alınan Fikir *</label>
                            <select name="referenceIdeaId" class="form-select form-select-sm" required>
                                <option value="">-- Referans Alınacak Olumlu Fikri Seçin --</option>
                                @foreach (var idea in Model)
                                {
                                    <option value="@idea.Id">@idea.Title (Fikir Sahibi: @idea.User?.FirstName @idea.User?.LastName - Sicil: @idea.User?.RegistrationNumber)</option>
                                }
                            </select>
                            <div class="form-text" style="font-size: 0.78rem;">Seçilen fikrin sahibi Pırıltılı Fikirler vitrininde otomatik olarak onurlandırılacaktır.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Uygulama / Proje Başlığı *</label>
                            <input type="text" name="projectTitle" class="form-control form-control-sm" placeholder="Örn: Yapay Zeka Destekli Doküman & Raporlama Modülü v1.0" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Hayata Geçirilme & Geliştirilme Detayı *</label>
                            <textarea name="developmentStory" class="form-control form-control-sm" rows="4" placeholder="Fikir kurum bünyesinde nasıl geliştirildi? Hangi departmanlar çalıştı ve ne gibi aşamalardan geçti?" required></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Elde Edilen Net Kurumsal Fayda *</label>
                            <textarea name="achievedBenefit" class="form-control form-control-sm" rows="3" placeholder="Bu uygulamanın kuruma kazandırdığı hız, tasarruf veya verimlilik artışı nedir?" required></textarea>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3" style="border-top: 1px solid var(--border-subtle);">
                            <a href="/Idea/Showcase" class="btn btn-sm btn-secondary-custom px-3">İptal</a>
                            <button type="submit" class="btn btn-sm btn-brand px-4">
                                <i class="bi bi-stars me-1"></i> Vitrinde Yayınla
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
