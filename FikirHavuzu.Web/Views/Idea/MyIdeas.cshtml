@model IEnumerable<FikirHavuzu.Entity.Entities.Idea>
@{
    ViewData["Title"] = "Fikirlerim";
    string currentFilter = ViewBag.CurrentFilter ?? "all";
    string currentSort = ViewBag.CurrentSort ?? "date_desc";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color: var(--text-primary); letter-spacing: -0.02em;">✨ Fikirlerim</h3>
            <p class="mb-0" style="color: var(--text-secondary); font-size: 0.95rem;">Sisteme sunduğunuz veya taslak halindeki tüm fikirlerinizi buradan takip edebilirsiniz.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <select class="form-select form-select-sm" style="width: auto; min-width: 150px; font-size: 0.85rem; border-color: var(--border-subtle);" onchange="window.location.href='/Idea/MyIdeas?filter=@currentFilter&sort=' + this.value;">
                <option value="date_desc" selected="@(currentSort == "date_desc")">📅 En Yeni</option>
                <option value="date_asc" selected="@(currentSort == "date_asc")">📅 En Eski</option>
                <option value="title_asc" selected="@(currentSort == "title_asc")">🔤 Başlık (A-Z)</option>
                <option value="title_desc" selected="@(currentSort == "title_desc")">🔤 Başlık (Z-A)</option>
            </select>
            <div class="btn-group" role="group">
                <a href="/Idea/MyIdeas?filter=all&sort=@currentSort" class="btn btn-sm @(currentFilter == "all" ? "btn-brand" : "btn-secondary-custom")">Tüm</a>
                <a href="/Idea/MyIdeas?filter=draft&sort=@currentSort" class="btn btn-sm @(currentFilter == "draft" ? "btn-brand" : "btn-secondary-custom")">📝 Taslak</a>
                <a href="/Idea/MyIdeas?filter=pending&sort=@currentSort" class="btn btn-sm @(currentFilter == "pending" ? "btn-brand" : "btn-secondary-custom")">⏳ Bekleyen</a>
                <a href="/Idea/MyIdeas?filter=approved&sort=@currentSort" class="btn btn-sm @(currentFilter == "approved" ? "btn-brand" : "btn-secondary-custom")">✅ Olumlu</a>
                <a href="/Idea/MyIdeas?filter=rejected&sort=@currentSort" class="btn btn-sm @(currentFilter == "rejected" ? "btn-brand" : "btn-secondary-custom")">❌ Olumsuz</a>
            </div>
            <a href="/Idea/Create" class="btn btn-sm btn-brand">
                <i class="bi bi-plus me-1"></i> Yeni Fikir Ekle
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 py-2 px-3 mb-4" style="font-size: 0.9rem;" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 py-2 px-3 mb-4" style="font-size: 0.9rem;" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="flat-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="clean-table mb-0">
                <thead>
                    <tr>
                        <th>Başlık</th>
                        <th>Kategori</th>
                        <th>Oluşturma Tarihi</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">Bu filtre kriterine uygun bir fikir öneriniz bulunamadı.</td>
                        </tr>
                    }
                    @foreach (var idea in Model)
                    {
                        <tr>
                            <td class="fw-semibold" style="color: var(--text-primary);">
                                @idea.Title
                                @if (idea.IsEdited)
                                {
                                    <span class="badge-soft-neutral ms-1" style="font-size: 0.68rem;">Düzenlendi</span>
                                }
                            </td>
                            <td style="color: var(--text-secondary);">@(idea.Category?.Name ?? "Diğer")</td>
                            <td class="text-muted" style="font-size: 0.82rem;">@idea.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                @if (idea.Status == FikirHavuzu.Entity.Enums.IdeaStatus.Draft)
                                {
                                    <span class="badge-soft-neutral"><i class="bi bi-pencil me-1"></i> Taslak</span>
                                }
                                else if (idea.Status == FikirHavuzu.Entity.Enums.IdeaStatus.Implemented)
                                {
                                    <span class="badge-soft-amber"><i class="bi bi-stars me-1"></i> Pırıltılı Fikir</span>
                                }
                                else if (idea.Status == FikirHavuzu.Entity.Enums.IdeaStatus.Approved)
                                {
                                    <span class="badge-soft-green">Olumlu</span>
                                }
                                else if (idea.Status == FikirHavuzu.Entity.Enums.IdeaStatus.Rejected)
                                {
                                    <span class="badge-soft-red">Olumsuz</span>
                                }
                                else if (idea.Status == FikirHavuzu.Entity.Enums.IdeaStatus.Withdrawn)
                                {
                                    <span class="badge-soft-neutral">Geri Çekildi</span>
                                }
                                else
                                {
                                    <span class="badge-soft-amber">Bekleyen</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (idea.Status == FikirHavuzu.Entity.Enums.IdeaStatus.Draft)
                                {
                                    <a href="/Idea/Edit/@idea.Id" class="btn btn-sm btn-secondary-custom py-1 px-2 me-1" title="Taslağı Düzenle"><i class="bi bi-pencil me-1"></i> Düzenle</a>
                                    <form action="/Idea/PublishDraft/@idea.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-brand py-1 px-2 me-1" title="Fikri Havuza At"><i class="bi bi-send me-1"></i> Havuza At</button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-secondary-custom text-danger py-1 px-2 me-1" onclick="openWithdrawModal(@idea.Id, '@idea.Title.Replace("'", "\\'")')" title="Taslağı Sil / Geri Çek"><i class="bi bi-arrow-counterclockwise me-1"></i> Geri Çek</button>
                                }
                                else if (idea.Status == FikirHavuzu.Entity.Enums.IdeaStatus.Pending)
                                {
                                    <a href="/Idea/Edit/@idea.Id" class="btn btn-sm btn-secondary-custom py-1 px-2 me-1" title="Fikri Düzenle"><i class="bi bi-pencil me-1"></i> Düzenle</a>
                                    <button type="button" class="btn btn-sm btn-secondary-custom text-danger py-1 px-2 me-1" onclick="openWithdrawModal(@idea.Id, '@idea.Title.Replace("'", "\\'")')" title="Fikri Geri Çek"><i class="bi bi-arrow-counterclockwise me-1"></i> Geri Çek</button>
                                    <a href="/Idea/Details/@idea.Id" class="btn btn-sm btn-secondary-custom py-1 px-2">Detay</a>
                                }
                                else
                                {
                                    <a href="/Idea/Details/@idea.Id" class="btn btn-sm btn-secondary-custom py-1 px-2">Detayları Gör</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="withdrawModal" tabindex="-1" aria-labelledby="withdrawModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content flat-card p-2 border-0 shadow-sm" style="border: 1px solid var(--border-subtle) !important;">
            <div class="modal-body text-center py-4">
                <span class="fs-1 d-block mb-2">✨</span>
                <h5 class="fw-bold mb-2" style="color: var(--text-primary);">Bu ışıltılı hayatı o seçmedi...</h5>
                <p class="text-muted mb-3" style="font-size: 0.9rem;">
                    "<strong id="modalIdeaTitle" style="color: var(--text-primary);"></strong>" fikrini geri çekmek istediğine gerçekten emin misin?
                </p>
                <div class="p-3 rounded-2 text-start small mb-0" style="background-color: var(--bg-canvas); border: 1px solid var(--border-subtle); color: var(--text-secondary);">
                    <i class="bi bi-stars text-warning me-1"></i> Aramızdan ayrılan sadece bir taslak, asıl ışıltın hâlâ sende saklı. <br />
                    <small class="text-muted d-block mt-1"><em>(Fikriniz değerlendirmeden çekilse dahi sistem arşivinde denetim amacıyla saklanmaya devam eder).</em></small>
                </div>
            </div>
            <div class="modal-footer border-0 d-flex justify-content-center gap-2 pt-0 pb-3">
                <button type="button" class="btn btn-sm btn-secondary-custom px-3" data-bs-dismiss="modal">Hala ışığı var. ✨</button>
                <form id="withdrawForm" action="" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-danger px-3 fw-medium">Veda vakti geldi. 🪦</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openWithdrawModal(ideaId, ideaTitle) {
            document.getElementById('modalIdeaTitle').innerText = ideaTitle;
            document.getElementById('withdrawForm').action = '/Idea/Withdraw/' + ideaId;
            var modal = new bootstrap.Modal(document.getElementById('withdrawModal'));
            modal.show();
        }
    </script>
}
