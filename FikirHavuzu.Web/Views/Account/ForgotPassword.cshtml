@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Şifremi Unuttum - Fikir Havuzu</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="shortcut icon" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background: linear-gradient(135deg, rgba(220, 230, 223, 0.94) 0%, rgba(201, 217, 206, 0.92) 100%), url('/modal-bg-watermark.svg') no-repeat center bottom / cover fixed;
            color: #24382C;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            margin: 0;
        }
        .login-card {
            background-color: #FFFFFF;
            border: 1px solid #C2D4C8;
            border-radius: 16px;
            padding: 38px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 10px 30px rgba(42, 63, 51, 0.08);
        }
        .btn-brand {
            background-color: #568770;
            border: 1px solid #45725D;
            color: #FFFFFF;
            font-weight: 500;
            border-radius: 8px;
            padding: 9px 16px;
            width: 100%;
            transition: background-color 0.15s ease;
        }
        .btn-brand:hover {
            background-color: #45725D;
            color: #FFFFFF;
        }
        .form-control {
            border-color: #C8D7CE;
            border-radius: 6px;
        }
        .form-control:focus {
            border-color: #568770;
            box-shadow: 0 0 0 0.2rem rgba(86, 135, 112, 0.15);
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center mb-2">
                <img src="~/favicon.svg" alt="Logo" style="width: 54px; height: 54px; border-radius: 50%; box-shadow: 0 4px 14px rgba(45, 90, 68, 0.2);" />
            </div>
            <h4 class="fw-bold mb-1" style="color: #24382C;">Şifremi Unuttum</h4>
            <p class="text-muted small mb-0">Sicil numaranızı veya e-posta adresinizi giriniz.</p>
        </div>

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success py-3 px-3 small rounded-3 mb-3" role="alert">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <strong>Bağlantı Gönderildi!</strong>
                </div>
                <p class="mb-0">@ViewBag.SuccessMessage</p>
            </div>
            <div class="text-center mt-3">
                <a href="/Account/Login" class="btn btn-sm btn-brand">Giriş Ekranına Dön</a>
            </div>
        }
        else
        {
            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger py-2 px-3 small rounded-2 mb-3" role="alert">
                    @ViewBag.ErrorMessage
                </div>
            }

            <form action="/Account/ForgotPassword" method="post" id="forgotPasswordForm">
                <div id="emailSection">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-secondary">E-posta</label>
                        <input type="email" name="email" id="emailInput" class="form-control form-control-sm" placeholder="Örn: ad.soyad@kurum.com" required />
                        <div class="form-text mb-2" style="font-size: 0.75rem;">Hesabınıza kayıtlı e-posta adresine tek kullanımlık sıfırlama linki iletilecektir.</div>
                    </div>
                    <div class="mb-4 text-end">
                        <a href="javascript:void(0);" onclick="toggleMethod('sicil')" class="text-decoration-none small" style="color: #568770;"><i class="bi bi-arrow-right-short"></i> Sicil Numaram ile sıfırlamak istiyorum</a>
                    </div>
                </div>

                <div id="sicilSection" style="display: none;">
                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-secondary">Sicil Numarası</label>
                        <input type="text" name="registrationNumber" id="sicilInput" class="form-control form-control-sm" placeholder="Örn: PER2409..." />
                        <div class="form-text mb-2" style="font-size: 0.75rem;">Bu sicil numarasına ait hesaba tanımlı e-posta adresine sıfırlama linki iletilecektir.</div>
                    </div>
                    <div class="mb-4 text-end">
                        <a href="javascript:void(0);" onclick="toggleMethod('email')" class="text-decoration-none small" style="color: #568770;"><i class="bi bi-arrow-right-short"></i> E-posta ile sıfırlamak istiyorum</a>
                    </div>
                </div>

                <button type="submit" class="btn btn-brand mb-3 w-100">Sıfırlama Linki Gönder</button>
                
                <div class="text-center">
                    <a href="/Account/Login" class="text-decoration-none small" style="color: #568770;">Giriş Ekranına Dön</a>
                </div>
            </form>

            <script>
                function toggleMethod(method) {
                    const emailSec = document.getElementById('emailSection');
                    const sicilSec = document.getElementById('sicilSection');
                    const emailInput = document.getElementById('emailInput');
                    const sicilInput = document.getElementById('sicilInput');

                    if (method === 'sicil') {
                        emailSec.style.display = 'none';
                        sicilSec.style.display = 'block';
                        emailInput.value = '';
                        emailInput.removeAttribute('required');
                        sicilInput.setAttribute('required', 'required');
                    } else {
                        sicilSec.style.display = 'none';
                        emailSec.style.display = 'block';
                        sicilInput.value = '';
                        sicilInput.removeAttribute('required');
                        emailInput.setAttribute('required', 'required');
                    }
                }
            </script>
        }

        <div class="text-center mt-4 pt-3" style="border-top: 1px solid #E5EDE7; font-size: 0.75rem; color: #7B9485;">
            &copy; @DateTime.Now.Year - <strong>TRtek Yazılım</strong> Fikir Havuzu - Staj Projesi
        </div>
    </div>
</body>
</html>
