@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap - Fikir Havuzu</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background: linear-gradient(135deg, rgba(220, 230, 223, 0.94) 0%, rgba(201, 217, 206, 0.92) 100%), url('/modal-bg-watermark.svg') no-repeat center bottom / cover fixed;
            color: #24382C;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            margin: 0;
        }
        .login-card {
            background-color: #FFFFFF;
            border: 1px solid #C2D4C8;
            border-radius: 16px;
            padding: 38px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 10px 30px rgba(42, 63, 51, 0.08);
        }
        .btn-brand {
            background-color: #568770;
            border: 1px solid #45725D;
            color: #FFFFFF;
            font-weight: 500;
            border-radius: 8px;
            padding: 9px 16px;
            width: 100%;
            transition: background-color 0.15s ease;
        }
        .btn-brand:hover {
            background-color: #45725D;
            color: #FFFFFF;
        }
        .form-control {
            border-color: #C8D7CE;
            border-radius: 6px;
        }
        .form-control:focus {
            border-color: #568770;
            box-shadow: 0 0 0 0.2rem rgba(86, 135, 112, 0.15);
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center mb-2">
                <img src="~/favicon.svg" alt="Logo" style="width: 54px; height: 54px; border-radius: 50%; box-shadow: 0 4px 14px rgba(45, 90, 68, 0.2);" />
            </div>
            <h4 class="fw-bold mb-1" style="color: #24382C;">Fikir Havuzu</h4>
            <p class="text-muted small mb-0">Kurumsal İnovasyon Portalı</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success py-2 px-3 small rounded-2 mb-3" role="alert">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger py-2 px-3 small rounded-2 mb-3" role="alert">
                @ViewBag.ErrorMessage
            </div>
        }

        <form action="/Account/Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Sicil Numarası</label>
                <input type="text" name="registrationNumber" class="form-control form-control-sm font-monospace" placeholder="PER260902002" required />
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label small fw-semibold text-secondary mb-0">Şifre</label>
                    <a href="/Account/ForgotPassword" class="text-decoration-none small" style="color: #568770; font-size: 0.78rem;">Şifremi Unuttum</a>
                </div>
                <input type="password" name="password" class="form-control form-control-sm" placeholder="••••••••" required />
            </div>

            <div class="mb-4 form-check">
                <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe" value="true">
                <label class="form-check-label small text-muted" for="rememberMe">Beni Hatırla</label>
            </div>

            <button type="submit" class="btn btn-brand">Giriş Yap</button>
        </form>

        <div class="text-center mt-4 pt-3" style="border-top: 1px solid #E5EDE7; font-size: 0.75rem; color: #7B9485;">
            &copy; @DateTime.Now.Year - <strong>TRtek Yazılım</strong> Fikir Havuzu - Staj Projesi
        </div>
    </div>
</body>
</html>
