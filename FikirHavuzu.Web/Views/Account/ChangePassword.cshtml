@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Şifre Değiştir - Fikir Havuzu</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, rgba(220, 230, 223, 0.94) 0%, rgba(201, 217, 206, 0.92) 100%), url('/modal-bg-watermark.svg') no-repeat center bottom / cover fixed;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(42, 63, 51, 0.08);
            background: #ffffff;
        }
        .btn-primary {
            background-color: #568770;
            border-color: #45725D;
        }
        .btn-primary:hover {
            background-color: #45725D;
            border-color: #45725D;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-4">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center mb-2">
                            <img src="~/favicon.svg" alt="Logo" style="width: 54px; height: 54px; border-radius: 50%; box-shadow: 0 4px 14px rgba(45, 90, 68, 0.2);" />
                        </div>
                        <h3 class="fw-bold text-dark mb-1">İlk Giriş: Şifrenizi Güncelleyin</h3>
                        <p class="text-muted small">Güvenliğiniz için lütfen yeni bir şifre belirleyin.</p>
                    </div>

                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @ViewBag.ErrorMessage
                        </div>
                    }

                    <form action="/Account/ChangePassword" method="post">
                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold">Yeni Şifre</label>
                            <input type="password" name="newPassword" class="form-control form-control-lg" placeholder="Yeni şifreniz" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary fw-semibold">Yeni Şifre Tekrar</label>
                            <input type="password" name="confirmPassword" class="form-control form-control-lg" placeholder="Şifrenizi doğrulayın" required />
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold text-white">Şifremi Güncelle ve Giriş Yap</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
