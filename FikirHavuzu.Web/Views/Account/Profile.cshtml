@model FikirHavuzu.Entity.Entities.User
@{
    ViewData["Title"] = "Profilim";
    var permissions = ViewBag.MyPermissions as List<FikirHavuzu.Entity.Entities.Permission> ?? new List<FikirHavuzu.Entity.Entities.Permission>();
    string maskedTc = !string.IsNullOrEmpty(Model.TCNo) && Model.TCNo.Length >= 11
        ? Model.TCNo.Substring(0, 3) + "*****" + Model.TCNo.Substring(Model.TCNo.Length - 3)
        : "***";
}

<div class="container-fluid px-0">
    <div class="mb-4">
        <h3 class="fw-bold mb-1" style="color: var(--text-primary); letter-spacing: -0.02em;">👤 Profilim & Hesap Ayarları</h3>
        <p class="mb-0" style="color: var(--text-secondary); font-size: 0.95rem;">Kişisel bilgilerinizi inceleyebilir, profil fotoğrafınızı ve güvenlik tercihlerinizi güncelleyebilirsiniz.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 py-2 px-3 mb-4" style="font-size: 0.9rem;" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 py-2 px-3 mb-4" style="font-size: 0.9rem;" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="flat-card text-center mb-4">
                <div class="position-relative d-inline-block mb-3">
                    @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                    {
                        <img id="avatarImage" src="@Model.ProfilePictureUrl" class="rounded-circle" style="width: 88px; height: 88px; min-width: 88px; min-height: 88px; aspect-ratio: 1/1; object-fit: cover; border: 3px solid var(--brand-primary);" />
                    }
                    else
                    {
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold fs-3" style="width: 88px; height: 88px; min-width: 88px; min-height: 88px; aspect-ratio: 1/1; background-color: var(--brand-primary-light); color: var(--brand-primary);">
                            @(Model.FirstName.Substring(0, 1))@(Model.LastName.Substring(0, 1))
                        </div>
                    }
                </div>
                <h5 class="fw-bold mb-1" style="color: var(--text-primary);">@Model.FirstName @Model.LastName</h5>
                <span class="text-muted small d-block mb-2">Sicil No: @Model.RegistrationNumber</span>

                <div class="mb-3">
                    <span class="badge" style="background-color: #FEF3C7; color: #92400E; border: 1px solid #F59E0B; font-size: 0.78rem; padding: 5px 12px; border-radius: 20px;">
                        @ViewBag.UserBadgeIcon @ViewBag.UserBadgeTitle (@ViewBag.InnovationPoints Puan)
                    </span>
                </div>

                <div class="pt-3 border-top d-flex justify-content-around text-center" style="border-color: var(--border-subtle) !important;">
                    <div>
                        <div class="fw-bold fs-5" style="color: var(--text-primary);">@ViewBag.TotalIdeasCount</div>
                        <small class="text-muted" style="font-size: 0.72rem;">Fikirlerim</small>
                    </div>
                    <div>
                        <div class="fw-bold fs-5" style="color: var(--badge-green-text);">@ViewBag.ApprovedIdeasCount</div>
                        <small class="text-muted" style="font-size: 0.72rem;">Onaylanan</small>
                    </div>
                    <div>
                        <div class="fw-bold fs-5" style="color: var(--badge-amber-text);">@ViewBag.ImplementedIdeasCount</div>
                        <small class="text-muted" style="font-size: 0.72rem;">Pırıltılı</small>
                    </div>
                    <div>
                        <div class="fw-bold fs-5 text-warning" style="font-size: 1.1rem;">@ViewBag.InnovationPoints</div>
                        <small class="text-muted" style="font-size: 0.72rem;">Puan</small>
                    </div>
                </div>
            </div>

            <div class="flat-card">
                <h6 class="fw-bold mb-3" style="color: var(--text-primary);"><i class="bi bi-shield-lock me-1" style="color: var(--brand-primary);"></i> Tanımlı Yetkilerim</h6>
                @if (!permissions.Any())
                {
                    <p class="text-muted small mb-0">Pırıltılı fikirlerin kaynağı sizsiniz! Yeni önerilerinizi iletebilir ve vitrine eklenen fikirleri takip edebilirsiniz.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var perm in permissions)
                        {
                            <span class="badge-soft-neutral">@perm.Name</span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-8">
            <div class="flat-card">
                <form action="/Account/Profile" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="removeProfilePhoto" id="removeProfilePhotoInput" value="false" />
                    
                    <h6 class="fw-bold mb-3" style="color: var(--text-primary);"><i class="bi bi-info-circle me-1" style="color: var(--brand-primary);"></i> Temel Bilgiler</h6>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Ad</label>
                            <input type="text" class="form-control form-control-sm bg-light" value="@Model.FirstName" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">Soyad</label>
                            <input type="text" class="form-control form-control-sm bg-light" value="@Model.LastName" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">E-posta</label>
                            <input type="email" class="form-control form-control-sm bg-light" value="@Model.Email" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">TC Kimlik No</label>
                            <input type="text" class="form-control form-control-sm bg-light font-monospace" value="@maskedTc" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Telefon Numarası</label>
                            <input type="tel" name="phoneNumber" class="form-control form-control-sm" value="@Model.PhoneNumber" maxlength="11" placeholder="05XXXXXXXXX" pattern="[0-9]{10,11}" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Profil Fotoğrafı İşlemi</label>
                            <input type="file" name="profilePhoto" id="photoFileInput" class="form-control form-control-sm" accept="image/*" />
                            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                            {
                                <div class="mt-2" id="removePhotoWrapper">
                                    <button type="button" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 0.78rem;" onclick="markPhotoForRemoval()">
                                        <i class="bi bi-trash3 me-1"></i> Fotoğrafı Kaldır
                                    </button>
                                </div>
                                <div class="mt-2 alert alert-warning py-1 px-2 small d-none" id="removalNotice" style="font-size: 0.78rem;">
                                    <i class="bi bi-exclamation-triangle me-1"></i> Fotoğraf kaldırılmak üzere işaretlendi. Kaydetmek için aşağıdaki <strong>"Bilgileri Güncelle"</strong> butonuna basın.
                                    <button type="button" class="btn btn-link btn-sm text-decoration-none text-danger p-0 ms-2" onclick="cancelPhotoRemoval()">Geri Al</button>
                                </div>
                            }
                        </div>
                    </div>

                    <h6 class="fw-bold mb-3 pt-3" style="border-top: 1px solid var(--border-subtle); color: var(--text-primary);"><i class="bi bi-key me-1" style="color: var(--brand-primary);"></i> Güvenlik & Şifre Değiştir</h6>
                    <p class="text-muted small mb-3">Şifrenizi değiştirmek istemiyorsanız bu alanları boş bırakabilirsiniz.</p>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Mevcut Şifre</label>
                            <input type="password" name="currentPassword" class="form-control form-control-sm" placeholder="••••••••" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Yeni Şifre</label>
                            <input type="password" name="newPassword" class="form-control form-control-sm" placeholder="••••••••" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold" style="color: var(--text-secondary);">Yeni Şifre (Tekrar)</label>
                            <input type="password" name="confirmPassword" class="form-control form-control-sm" placeholder="••••••••" />
                        </div>
                    </div>

                    <div class="p-2 rounded-2 small mb-4" style="background-color: var(--bg-canvas); border: 1px solid var(--border-subtle); color: var(--text-secondary); font-size: 0.78rem;">
                        <i class="bi bi-shield-check text-success me-1"></i> Yeni şifreniz en az 8 karakter uzunluğunda olmalı; en az bir büyük harf, bir küçük harf, bir rakam ve bir özel karakter içermelidir.
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-sm btn-brand px-4">Bilgileri Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function markPhotoForRemoval() {
            document.getElementById('removeProfilePhotoInput').value = 'true';
            document.getElementById('removePhotoWrapper').classList.add('d-none');
            document.getElementById('removalNotice').classList.remove('d-none');
            document.getElementById('photoFileInput').value = '';
        }

        function cancelPhotoRemoval() {
            document.getElementById('removeProfilePhotoInput').value = 'false';
            document.getElementById('removePhotoWrapper').classList.remove('d-none');
            document.getElementById('removalNotice').classList.add('d-none');
        }
    </script>
}
