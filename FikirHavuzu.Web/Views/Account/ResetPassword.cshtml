@{
    ViewData["Title"] = "Yeni Şifre Belirle";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yeni Şifre Belirle - Fikir Havuzu</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="shortcut icon" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background: linear-gradient(135deg, rgba(220, 230, 223, 0.94) 0%, rgba(201, 217, 206, 0.92) 100%), url('/modal-bg-watermark.svg') no-repeat center bottom / cover fixed;
            color: #24382C;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            margin: 0;
        }
        .reset-card {
            background-color: #FFFFFF;
            border: 1px solid #C2D4C8;
            border-radius: 16px;
            padding: 36px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 10px 30px rgba(42, 63, 51, 0.08);
        }
        .btn-brand {
            background-color: #568770;
            border: 1px solid #45725D;
            color: #FFFFFF;
            font-weight: 500;
            border-radius: 8px;
            padding: 9px 16px;
            width: 100%;
            transition: background-color 0.15s ease;
        }
        .btn-brand:hover {
            background-color: #45725D;
            color: #FFFFFF;
        }
        .form-control {
            border-color: #C8D7CE;
            border-radius: 6px;
        }
        .form-control:focus {
            border-color: #568770;
            box-shadow: 0 0 0 0.2rem rgba(86, 135, 112, 0.15);
        }
    </style>
</head>
<body>
    <div class="reset-card">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center mb-2">
                <img src="~/favicon.svg" alt="Logo" style="width: 52px; height: 52px; border-radius: 50%; box-shadow: 0 4px 14px rgba(45, 90, 68, 0.2);" />
            </div>
            <h4 class="fw-bold mb-1" style="color: #24382C;">Yeni Şifre Belirle</h4>
            <p class="text-muted small mb-0"><strong>@ViewBag.FullName</strong> (@ViewBag.Email) hesabınız için yeni şifrenizi tanımlayınız.</p>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger py-2 px-3 small rounded-2 mb-3" role="alert">
                @ViewBag.ErrorMessage
            </div>
        }

        <form action="/Account/ResetPassword" method="post">
            <input type="hidden" name="email" value="@ViewBag.Email" />
            <input type="hidden" name="token" value="@ViewBag.Token" />

            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Yeni Şifre *</label>
                <input type="password" name="newPassword" id="newPassword" class="form-control form-control-sm" placeholder="••••••••" required oninput="checkStrength(this.value)" />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Yeni Şifre (Tekrar) *</label>
                <input type="password" name="confirmPassword" class="form-control form-control-sm" placeholder="••••••••" required />
            </div>

            <!-- Password Policy Hints -->
            <div class="p-3 mb-4 rounded-3" style="background-color: #F8FAFC; border: 1px solid #E2E8F0; font-size: 0.78rem;">
                <div class="fw-semibold mb-2 text-secondary">Şifre Güvenlik Kriterleri:</div>
                <div id="rule-length" class="text-muted mb-1"><i class="bi bi-circle me-1"></i> En az 8 karakter</div>
                <div id="rule-upper" class="text-muted mb-1"><i class="bi bi-circle me-1"></i> En az bir büyük harf (A-Z)</div>
                <div id="rule-lower" class="text-muted mb-1"><i class="bi bi-circle me-1"></i> En az bir küçük harf (a-z)</div>
                <div id="rule-digit" class="text-muted mb-1"><i class="bi bi-circle me-1"></i> En az bir rakam (0-9)</div>
                <div id="rule-special" class="text-muted"><i class="bi bi-circle me-1"></i> En az bir özel karakter (!, @@, #, $, vb.)</div>
            </div>

            <button type="submit" class="btn btn-brand mb-3">Şifremi Güncelle ve Giriş Yap</button>

            <div class="text-center">
                <a href="/Account/Login" class="text-decoration-none small" style="color: #568770;">Vazgeç, Giriş Ekranına Dön</a>
            </div>
        </form>

        <div class="text-center mt-4 pt-3" style="border-top: 1px solid #E5EDE7; font-size: 0.75rem; color: #7B9485;">
            &copy; @DateTime.Now.Year - <strong>TRtek Yazılım</strong> Fikir Havuzu - Staj Projesi
        </div>
    </div>

    <script>
        function checkStrength(val) {
            const hasLen = val.length >= 8;
            const hasUpper = /[A-Z]/.test(val);
            const hasLower = /[a-z]/.test(val);
            const hasDigit = /[0-9]/.test(val);
            const hasSpecial = /[^A-Za-z0-9]/.test(val);

            updateRule('rule-length', hasLen);
            updateRule('rule-upper', hasUpper);
            updateRule('rule-lower', hasLower);
            updateRule('rule-digit', hasDigit);
            updateRule('rule-special', hasSpecial);
        }

        function updateRule(id, valid) {
            const el = document.getElementById(id);
            if (!el) return;
            if (valid) {
                el.className = "text-success fw-medium mb-1";
                el.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> ' + el.innerText.replace(/^.*?\s/, '');
            } else {
                el.className = "text-muted mb-1";
                el.innerHTML = '<i class="bi bi-circle me-1"></i> ' + el.innerText.replace(/^.*?\s/, '');
            }
        }
    </script>
</body>
</html>
