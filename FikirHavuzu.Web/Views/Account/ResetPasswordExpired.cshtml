@{
    ViewData["Title"] = "Bağlantı Süresi Doldu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bağlantı Geçersiz - Fikir Havuzu</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="shortcut icon" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background: linear-gradient(135deg, rgba(220, 230, 223, 0.94) 0%, rgba(201, 217, 206, 0.92) 100%), url('/modal-bg-watermark.svg') no-repeat center bottom / cover fixed;
            color: #24382C;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            margin: 0;
        }
        .error-card {
            background-color: #FFFFFF;
            border: 1px solid #C2D4C8;
            border-radius: 16px;
            padding: 38px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 10px 30px rgba(42, 63, 51, 0.08);
            text-align: center;
        }
        .btn-brand {
            background-color: #568770;
            border: 1px solid #45725D;
            color: #FFFFFF;
            font-weight: 500;
            border-radius: 8px;
            padding: 9px 20px;
            transition: background-color 0.15s ease;
        }
        .btn-brand:hover {
            background-color: #45725D;
            color: #FFFFFF;
        }
    </style>
</head>
<body>
    <div class="error-card">
        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px; background-color: #FEE2E2; color: #991B1B;">
            <i class="bi bi-clock-history fs-3"></i>
        </div>
        <h4 class="fw-bold mb-2" style="color: #24382C;">Bağlantı Geçersiz veya Süresi Doldu</h4>
        <p class="text-muted small mb-4">
            Güvenliğiniz gereği şifre sıfırlama bağlantıları <strong>10 dakika</strong> boyunca geçerlidir. Bu süreyi aştığınız veya bağlantı daha önce kullanıldığı için geçersiz kılınmıştır.
        </p>

        <div class="d-flex flex-column gap-2">
            <a href="/Account/ForgotPassword" class="btn btn-brand">Yeni Sıfırlama Bağlantısı İste</a>
            <a href="/Account/Login" class="btn btn-sm btn-outline-secondary">Giriş Ekranına Dön</a>
        </div>

        <div class="text-center mt-4 pt-3" style="border-top: 1px solid #E5EDE7; font-size: 0.75rem; color: #7B9485;">
            &copy; @DateTime.Now.Year - <strong>TRtek Yazılım</strong> Fikir Havuzu - Staj Projesi
        </div>
    </div>
</body>
</html>
